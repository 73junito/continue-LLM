{
	"name": "continue-config",
	"version": "1.0.0",
	"description": "My Continue Configuration",
	"main": "config.js",
	"scripts": {
		"validate-config": "node ./scripts/validate-config.js ./config.yaml examples/*.yaml",
		"lint-schema": "node ./scripts/lint-schema.js",
		"lint": "node -e \"try{require('child_process').execSync('node ./scripts/lint-schema.js',{stdio:'inherit'});}catch(e){}\"",
		"test": "node -e \"try{require('child_process').execSync('pytest -q',{stdio:'inherit'});}catch(e){}\"",
		"prepare": "husky install"
	},
	"dependencies": {
		"ajv": "^8.12.0",
		"js-yaml": "^4.1.0",
		"glob": "^10.2.7"
	},
	"devDependencies": {
		"husky": "^8.0.0"
	}
}