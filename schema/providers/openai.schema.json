{
  "$id": "providers/openai",
  "type": "object",
  "required": ["apiKey"],
  "properties": {
    "apiKey": { "type": "string" },
    "timeout": { "type": "integer", "minimum": 1000, "default": 10000 },
    "modelArgs": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 }
      },
      "additionalProperties": false
    }
  }
}
